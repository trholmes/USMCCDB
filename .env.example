# ============================================================================
# USMCC Collaboration Database — configuration
# Copy to .env (scripts/start.sh does this automatically on first run and
# fills in random secrets). Everything the stack needs is configured here.
# ============================================================================

# --- Container engine ---------------------------------------------------------
# Which engine the scripts/ use to run the stack: docker | podman | auto.
# auto (default) picks docker when it is installed, otherwise podman. Podman
# needs a compose provider: "podman compose" works once podman-compose (or
# docker-compose) is installed. Rootless podman notes: publishing ports below
# 1024 (the caddy HTTPS container) requires lowering
# net.ipv4.ip_unprivileged_port_start, and "restart: unless-stopped" only
# applies across reboots with the podman-restart systemd unit enabled — see
# the "Running under Podman" section of the README.
CONTAINER_ENGINE=auto

# --- PostgreSQL (dedicated container) ---------------------------------------
POSTGRES_DB=usmccdb
POSTGRES_USER=usmccdb
# REQUIRED (compose refuses to start while empty). start.sh fills this in
# automatically; by hand: openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Backend ----------------------------------------------------------------
# JWT signing key. REQUIRED (compose refuses to start while empty, and the
# backend refuses known placeholder values). start.sh fills this in
# automatically; by hand: openssl rand -hex 32
SECRET_KEY=

# Public address of this instance (used in ORCID redirects and docs/links).
# For production: https://db.muoncollider.us
SITE_URL=

# Shown on the login page so people know who to contact for access.
CONTACT_EMAIL=

# Bootstrap admin: created automatically at startup ONLY if no user accounts
# exist yet. start.sh generates a random password on first run. Change the
# password after first login (or create your own admin and deactivate this one).
# Leave the password empty to skip creating the bootstrap admin entirely.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Login session lifetime in hours.
ACCESS_TOKEN_HOURS=12

# auto (recommended): login cookie is marked Secure only when the request came
# over HTTPS (honors X-Forwarded-Proto from caddy/nginx). Force true/false if needed.
COOKIE_SECURE=auto

# Per-IP rate limits on the unauthenticated endpoints (password guessing on
# /auth/login, anonymous submissions to /people/register). "N attempts per
# WINDOW seconds"; set a limit to 0 to disable it. Defaults shown.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600

# --- ORCID login (optional but recommended) ----------------------------------
# Register a free public-API client at https://orcid.org/developer-tools with
# redirect URI:  ${SITE_URL}/api/v1/auth/orcid/callback
# Leave ORCID_CLIENT_ID empty to hide the "Sign in with ORCID" button.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# orcid.org for production, sandbox.orcid.org for testing
ORCID_HOST=orcid.org

# --- Outgoing email (optional) -------------------------------------------------
# Notification mail: registrations (to the admins and institution contacts,
# and back to the registrant on approval/rejection), speaker nominations and
# assignments, convener changes, and the publications workflow — see
# docs/NOTIFICATIONS.md for the full list. LEAVE SMTP_HOST EMPTY to disable
# email entirely — sends become logged no-ops (visible under Admin → Email)
# and every workflow still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default, port 587) | ssl (port 465) | none (trusted relay)
SMTP_TLS=starttls
# Where notifications for the database admins go (new registrations to
# review, duplicate / ORCID conflicts, review requests) — ideally a dedicated
# listserv for the people running the database. Falls back to CONTACT_EMAIL,
# which stays the address members see on the login page.
ADMIN_EMAIL=
# From: address; falls back to CONTACT_EMAIL when empty.
EMAIL_FROM=

# --- Ports & hosts ------------------------------------------------------------
# Docker Compose project name — prefixes every container/volume/network of
# this instance. Defaults to this DIRECTORY's name, so two checkouts in
# same-named directories would collide on the SAME database volume. Set it
# explicitly (with a distinct HTTP_PORT below) to run a second instance —
# e.g. a test one — on the same machine. start.sh fills this in when invoked
# as: COMPOSE_PROJECT_NAME=usmccdb-test ./scripts/start.sh
#COMPOSE_PROJECT_NAME=usmccdb-test

# Host port the web UI (nginx) is published on, and the interface it binds to.
# Default 127.0.0.1 = reachable only from this machine / via a TLS proxy, never
# plain HTTP from the network. Set BIND_HOST=0.0.0.0 only on a trusted private
# LAN. When an external proxy terminates TLS (see below), set HTTP_PORT to the
# port it forwards to — 5000 on the production db.muoncollider.us host.
HTTP_PORT=8080
BIND_HOST=127.0.0.1

# --- HTTPS ---------------------------------------------------------------------
# Two ways to go live (full details: README, "Going live"). Either way set
# SITE_URL above to the public https:// address.
#
# (a) External TLS proxy — the production setup: the host keeps running its
#     own web server (Apache, which also does Let's Encrypt) and reverse-
#     proxies the domain to localhost:HTTP_PORT. LEAVE SITE_DOMAIN EMPTY (no
#     caddy container) and set HTTP_PORT to the proxied port. The proxy must
#     send "X-Forwarded-Proto: https" — or force COOKIE_SECURE=true above.
#
# (b) Bundled Caddy — nothing else listening on 80/443: set SITE_DOMAIN to
#     your bare domain (db.muoncollider.us) and re-run scripts/start.sh. A
#     separate Caddy container will listen on the ports below, obtain +
#     auto-renew a Let's Encrypt certificate, and reverse-proxy to nginx.
#     Requires the domain's DNS A record pointing at this machine and both
#     ports open.
#
# LEAVE SITE_DOMAIN EMPTY to run without the caddy container (local-only, or
# behind an external proxy as in (a)).
SITE_DOMAIN=
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80

# --- Backups -------------------------------------------------------------------
# Hour of day (00-23, UTC) for the automatic nightly pg_dump.
BACKUP_HOUR=02
# Retention: how many daily / weekly / monthly dumps to keep.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Host directory the dumps are written to (bind-mounted into the containers
# at /backups). Relative paths are resolved against this file's directory.
BACKUP_DIR=./backups
